{
  "manifestVersion": 1,
  "meta": {
    "name": "Dogecoin Core (testnet)",
    "version": "0.0.1",
    "logoPath": "logo.png",
    "shortDescription": "Public testnet3 Dogecoin Core node",
    "longDescription": "Full Dogecoin Core v1.14.9 node on the PUBLIC testnet3 network. Fork of the stock Dogecoin Core pup with -testnet=1 and a capped -dbcache=800 (no txindex, wallet disabled) so it stays well inside the box's memory budget. RPC on pup-internal :22555, P2P :22556, ZMQ :28332.",
    "upstreamVersions": {
      "Core": "v1.14.9"
    }
  },
  "config": {
    "sections": null
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "67a7d130946703f1e10efaf5bce2531891a649683a3fd5ce20accdf3cd09d262"
    },
    "services": [
      {
        "name": "dogecoind",
        "command": {
          "exec": "/bin/run.sh",
          "cwd": "",
          "env": null
        }
      },
      {
        "name": "monitor",
        "command": {
          "exec": "/bin/monitor",
          "cwd": "",
          "env": null
        }
      },
      {
        "name": "logger",
        "command": {
          "exec": "/bin/logger",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "public-port",
        "type": "tcp",
        "port": 22556,
        "interfaces": [
          "core-network"
        ],
        "listenOnHost": true
      },
      {
        "name": "rpc",
        "type": "http",
        "port": 22555,
        "interfaces": [
          "core-rpc"
        ],
        "listenOnHost": false
      },
      {
        "name": "rpc-tcp",
        "type": "tcp",
        "port": 22555,
        "interfaces": [
          "core-rpc"
        ],
        "listenOnHost": false
      },
      {
        "name": "zmq",
        "type": "tcp",
        "port": 28332,
        "interfaces": [
          "core-zmq"
        ],
        "listenOnHost": false
      }
    ],
    "requiresInternet": true
  },
  "interfaces": [
    {
      "name": "core-rpc",
      "version": "0.0.1",
      "permissionGroups": [
        {
          "name": "RPC",
          "description": "Allows RPC access to the Dogecoin Core node",
          "severity": 2,
          "routes": [
            "/*"
          ],
          "port": 0
        }
      ]
    },
    {
      "name": "core-zmq",
      "version": "0.0.1",
      "permissionGroups": [
        {
          "name": "ZMQ",
          "description": "Allows ZMQ access to the Dogecoin Core node",
          "severity": 1,
          "routes": null,
          "port": 28332
        }
      ]
    },
    {
      "name": "core-network",
      "version": "0.0.1",
      "permissionGroups": [
        {
          "name": "Network",
          "description": "Allows access to the Dogecoin Core node's network port",
          "severity": 2,
          "routes": null,
          "port": 22556
        }
      ]
    }
  ],
  "dependencies": null,
  "metrics": [
    {
      "name": "chain",
      "label": "Chain",
      "type": "string",
      "history": 1
    },
    {
      "name": "blocks",
      "label": "Block Height",
      "type": "int",
      "history": 30
    },
    {
      "name": "headers",
      "label": "Headers",
      "type": "int",
      "history": 30
    },
    {
      "name": "difficulty",
      "label": "Difficulty",
      "type": "float",
      "history": 30
    },
    {
      "name": "verification_progress",
      "label": "Verification progress",
      "type": "string",
      "history": 1
    },
    {
      "name": "initial_block_download",
      "label": "Initial Download",
      "type": "string",
      "history": 1
    },
    {
      "name": "chain_size_human",
      "label": "Blockchain Size",
      "type": "string",
      "history": 1
    }
  ]
}
